# --- BAZA DANYCH ---
# Aplikacja łączy się przez @prisma/adapter-pg, więc działa z każdym Postgresem.
#
# Prisma Postgres:  postgres://USER:PASS@pooled.db.prisma.io:5432/postgres?sslmode=verify-full
# Supabase:         DATABASE_URL = pooler (port 6543, ?pgbouncer=true), DIRECT_URL = połączenie bezpośrednie (5432)
# Lokalnie:         npm run db:dev  →  postgres://postgres:postgres@localhost:51218/template1?sslmode=disable
DATABASE_URL=""

# Używane tylko przez CLI Prismy (migracje). Puste = DATABASE_URL.
DIRECT_URL=""

# Tylko do `prisma migrate dev` na lokalnym `prisma dev` (port shadow z komunikatu startowego)
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# --- DOMENA ---
# Pełny adres produkcyjny – z niego budowane są linki og:image dla Facebooka i Discorda
NEXT_PUBLIC_SITE_URL="https://turniej.twoja-domena.pl"

# --- BEZPIECZEŃSTWO ---
# Min. 32 znaki. Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- PIERWSZE KONTO ADMINA (npm run db:seed) ---
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Imię Nazwisko"

# --- TURNIEJ ---
# Minimalny czas lektury regulaminu przed wysłaniem zgłoszenia (s)
RULES_MIN_SECONDS=60
# Czas na ruch w veto CS2 (s), 0 = bez limitu
VETO_TURN_SECONDS=45
# false = natychmiastowe wstrzymanie zapisów
REGISTRATION_OPEN=true
